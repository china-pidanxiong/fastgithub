<UserControl x:Class="FastGithub.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🌐 域名列表" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Domains}"
                             SelectedItem="{Binding SelectedDomain}"
                             Height="140"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Text="{Binding NewDomainInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Margin="0,0,8,0"/>
                        <Button Content="添加" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddDomainCommand}" Padding="16,6"/>
                        <Button Content="删除选中" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveDomainCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🌍 DNS 服务器" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding DnsServers}"
                             SelectedItem="{Binding SelectedDnsServer}"
                             Height="100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Text="{Binding NewDnsServerInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Margin="0,0,8,0"/>
                        <Button Content="添加" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddDnsServerCommand}" Padding="16,6"/>
                        <Button Content="删除选中" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveDnsServerCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📁 hosts 文件路径" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding HostsPath}" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔧 高级设置" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="超时时间 (ms)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TimeoutMs}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="最大备份数" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MaxBackupCount}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="重置为默认" Style="{StaticResource SecondaryButton}"
                        Click="Reset_Click" Margin="0,0,8,0"/>
                <Button Content="💾 保存" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" Padding="20,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

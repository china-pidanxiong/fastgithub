<Window x:Class="FastGithub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastGithub.Views"
        Title="GitHub Hosts 加速器" Height="560" Width="760"
        MinWidth="640" MinHeight="480"
        Background="#f6f8fa"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#24292f">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8">
                <TextBlock Text="GitHub Hosts 加速器" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="{Binding Dashboard.StatusText}" Foreground="White" FontSize="12"/>
            <Button Grid.Column="2" Margin="0,6,12,6" Padding="12,4"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding Dashboard.RefreshCommand}"
                    Content="🔄 立即刷新"/>
        </Grid>

        <TabControl Background="White" Margin="0">
            <TabItem Header="仪表盘">
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>
            <TabItem Header="配置">
                <views:ConfigView DataContext="{Binding Config}"/>
            </TabItem>
            <TabItem Header="日志">
                <views:LogView DataContext="{Binding Log}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

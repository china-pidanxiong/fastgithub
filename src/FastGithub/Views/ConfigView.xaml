<UserControl x:Class="FastGithub.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="域名列表" Margin="0,0,0,8" Padding="8">
                    <StackPanel Orientation="Vertical">
                        <ListBox ItemsSource="{Binding Domains}" Height="180"
                                 SelectedItem="{Binding SelectedDomain}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding NewDomainInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" Margin="0,0,4,0"/>
                            <Button Content="添加" Padding="12,4" Margin="0,0,4,0"
                                    Command="{Binding AddDomainCommand}"/>
                            <Button Content="删除选中" Padding="12,4"
                                    Command="{Binding RemoveDomainCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="DNS 服务器" Margin="0,0,0,8" Padding="8">
                    <StackPanel Orientation="Vertical">
                        <ListBox ItemsSource="{Binding DnsServers}" Height="120"
                                 SelectedItem="{Binding SelectedDnsServer}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding NewDnsServerInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" Margin="0,0,4,0"/>
                            <Button Content="添加" Padding="12,4" Margin="0,0,4,0"
                                    Command="{Binding AddDnsServerCommand}"/>
                            <Button Content="删除选中" Padding="12,4"
                                    Command="{Binding RemoveDnsServerCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="hosts 文件路径" Margin="0,0,0,8" Padding="8">
                    <TextBox Text="{Binding HostsPath}" IsReadOnly="True"/>
                </GroupBox>
                <GroupBox Header="高级参数" Margin="0,0,0,8" Padding="8">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="最大备份数：" Width="100" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaxBackupCount}" Width="80"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="超时(ms)：" Width="100" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding TimeoutMs}" Width="80"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存" Padding="16,6" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>
            <Button Content="重置为默认" Padding="16,6" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
